+def symbol_addr(elf, name):
+    out = subprocess.run([PREFIX + "nm", elf], check=True, capture_output=True, text=True).stdout
+    for row in out.splitlines():
+        parts = row.split()
+        if len(parts) == 3 and parts[2] == name:
+            return int(parts[0], 16)
+    return None
+
